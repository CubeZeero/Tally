# Copy this file to .env and edit BEFORE the first `docker compose up`.
# Docker Compose reads this file for variable substitution.
# See the full reference: wiki "はじめに / Getting started".

# --- Required ---

# Secret used to sign session cookies. MUST be a long random string.
# Generate one with:  openssl rand -base64 32
# If unset/placeholder, the app uses a random per-process secret (sessions
# reset on every restart — everyone gets logged out).
SESSION_SECRET=""

# --- Core (optional) ---

# SQLite database location. Docker Compose sets this to the mounted volume
# (file:/data/tally.db) itself, so this line only affects LOCAL development
# (e.g. `npm run dev` / Prisma CLI). Leave the relative path for local use.
DATABASE_URL="file:./data/tally.db"

# Where the container stores its data (SQLite DB + backups). Point this at a
# host directory on external storage to keep data off the server's internal
# disk; create it first (e.g. `sudo mkdir -p /mnt/storage/tally/data`). If left
# unset, a Docker-managed named volume ("tally-data") is used.
# TALLY_DATA_DIR=/mnt/storage/tally/data

# Timezone for the notification scheduler (send time follows this).
# TZ="Asia/Tokyo"

# New sign-ups are disabled after the first user. Set to 0 for open registration.
# DISABLE_REGISTRATION=1

# Bind to loopback by default. To enable LAN/Tailscale, set the host's reachable
# IP explicitly. For a reverse proxy, leave loopback if it runs on the host.
# TALLY_BIND_ADDRESS=127.0.0.1

# Canonical HTTP(S) origin for OAuth and links when behind a reverse proxy.
# TALLY_PUBLIC_URL=https://tally.example.com

# Comma-separated exact webhook origins for custom services, proxies, and LAN.
# Built-in Discord, Slack, and ntfy.sh origins are already allowed.
# TALLY_NOTIFICATION_ORIGINS=https://notify.example.com,http://192.168.1.20:8080

# Exact per-user SMTP host:port pairs, comma-separated. SMTP requires TLS.
# TALLY_SMTP_DESTINATIONS=smtp.example.com:587

# Update check: the app compares its version against the latest GitHub tag and
# shows an "update available" banner. Set to 0 to disable (stops the periodic
# api.github.com request).
# UPDATE_CHECK=1

# --- Automatic backups (optional; sensible defaults shown) ---

# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_DIR=/data/backups

# --- Email (SMTP) fallback (optional) ---
# Per-user SMTP configured in Settings takes priority over these.

# SMTP_HOST=""
# SMTP_PORT="587"        # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Tally <you@example.com>"
