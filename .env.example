# SQLite database location (local development)
DATABASE_URL="file:./data/tally.db"

# Secret used to sign session cookies. MUST be a long random string.
# Generate one with:  openssl rand -base64 32
# If unset/placeholder, the app uses a random per-process secret (sessions
# reset on restart). Docker Compose also reads this file for substitution.
SESSION_SECRET=""

# Optional: set to 1 to block new sign-ups after the first account exists.
# DISABLE_REGISTRATION=1

# Optional: timezone for the notification scheduler (default Asia/Tokyo)
# TZ="Asia/Tokyo"
