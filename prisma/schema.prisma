generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One account per user. Per-user settings live here too.
model User {
  id                 String    @id @default(cuid())
  username           String    @unique // normalized (lowercased) — used for login/uniqueness
  displayName        String? // original-case name for display (falls back to username)
  passwordHash       String
  lang               String    @default("en") // ui language: en | ja
  currency           String    @default("JPY") // main display currency
  discordWebhookUrl  String?
  notifyEmail        String?
  notifyEmailEnabled Boolean   @default(false)
  webhookUrl         String? // generic webhook (Zapier / IFTTT / n8n …)
  webhookEnabled     Boolean   @default(false)
  slackWebhookUrl    String? // Slack incoming webhook
  slackEnabled       Boolean   @default(false)
  ntfyUrl            String? // full ntfy topic URL, e.g. https://ntfy.sh/my-topic
  ntfyToken          String? // optional ntfy access token (Bearer)
  ntfyEnabled        Boolean   @default(false)
  icalToken          String? // token for the read-only iCal feed (null = off)
  apiKey             String?   @unique // bearer key for the MCP endpoint / read API (null = off)
  restWriteApiKey    String?   @unique // REST read/write key, never accepted by MCP
  monthlyBudget      Float? // monthly budget in main currency (null = no budget)
  smtpHost           String?
  smtpPort           Int       @default(587)
  smtpUser           String?
  smtpPass           String?
  smtpFrom           String?
  notifyToken        String? // token for the optional /api/notify endpoint
  notifyDaysBefore   Int       @default(3)
  notifyEnabled      Boolean   @default(false) // built-in daily Discord scheduler on/off
  notifyHour         Int       @default(9) // hour of day (server local time) to send
  lastNotifiedOn     String? // YYYY-MM-DD of the last auto notification (dedupe)
  ratesJson          String? // JSON: { "USD": <units per 1 main>, ... }
  ratesUpdatedAt     DateTime?
  createdAt          DateTime  @default(now())

  subscriptions  Subscription[]
  categories     Category[]
  paymentMethods PaymentMethod[]
  oauthAuthCodes      OAuthAuthCode[]
  oauthRefreshTokens  OAuthRefreshToken[]
}

// ---- MCP OAuth 2.1 (authorization server) --------------------------------

// A client registered via Dynamic Client Registration (RFC 7591) or seeded.
model OAuthClient {
  id                      String   @id @default(cuid()) // the client_id
  clientName              String?
  redirectUris            String // JSON array of allowed redirect URIs
  grantTypes              String   @default("authorization_code,refresh_token") // CSV
  tokenEndpointAuthMethod String   @default("none") // "none" (public+PKCE) | "client_secret_post"
  clientSecretHash        String? // only for confidential clients
  scope                   String?  // space-separated requested scopes
  createdAt               DateTime @default(now())

  authCodes     OAuthAuthCode[]
  refreshTokens OAuthRefreshToken[]
}

// Short-lived authorization code bound to a PKCE challenge.
model OAuthAuthCode {
  code          String   @id // opaque random
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String // PKCE S256 challenge
  scope         String // space-separated granted scopes
  resource      String // RFC 8707 target resource (MCP endpoint URI)
  expiresAt     DateTime
  usedAt        DateTime? // set once redeemed (single-use)

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Rotating refresh token. Access tokens are stateless JWTs (not stored).
model OAuthRefreshToken {
  tokenHash String   @id // sha256 of the refresh token
  clientId  String
  userId    String
  scope     String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Category {
  id     String @id @default(cuid())
  userId String?
  name   String
  sort   Int    @default(0)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model PaymentMethod {
  id     String @id @default(cuid())
  userId String?
  name   String
  sort   Int    @default(0)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String?
  name          String
  description   String?
  cost          Float
  currency      String? // null => use main currency
  icon          String? // simple-icons slug, e.g. "netflix"
  image         String? // custom icon as a data URL (overrides icon when set)
  cycle         String   @default("month") // day | week | month | year
  cycleCount    Int      @default(1) // every N units
  startDate     DateTime // first billing date
  nextBillDate  DateTime? // optional explicit next payment date (anchor)
  trialEndDate  DateTime? // if set & in the future: free trial; first charge on this date
  category      String?
  paymentMethod String?
  url           String?
  cancelReminderDays Int? // remind this many days before renewal to decide (null = off)
  color         String   @default("#ff7a00")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
